  author = {{Welforum}},
  url = {https://www.welforum.it/area/poverta-e-disuguaglianze/},
  urldate = {2026-06-17},
  abstract = {PERCORSI DI LETTURA AREA POVERTÀ E DISUGUAGLIANZE L’AREA TEMATICA, curata dal vice-direttore di welforum.it~Daniela Mesini, si propone di fare il punto sull’evoluzione del fenomeno povertà e delle politiche di contrasto. Particolare attenzione è riservata alle misure nazionali di contrasto, già a partire dal SIA, REI, e più di recente all’implementazione del Reddito di Cittadinanza e dell’Assegno di Inclusione (AdI). Le misure nazionali vengono considerate a vari livelli: evoluzione normativa e procedurale, analisi dei dati disponibili, criticità ed opportunità attuative riscontrate dai territori, integrazione tra servizi e professioni per una più efficace attuazione. Altro focus dell’area è senz’altro l’analisi della multidimensionalità della povertà e l’acuirsi delle diseguaglianze, in seguito all’emergenza da Covid-19 ed alla crisi economico-finanziaria, che ne è conseguita. Sul tema sono stati pubblicati ben due monografici di Welforum, uno dei quali concentrato in particolare sull’aumento e la cronicizzazione della deprivazione estrema e della realtà delle persone senza dimora. Infine, soprattutto nell’ultimo anno, l’area ha dato spazio anche al tema dell’abitare, quale fattore chiave per l’inclusione delle persone e famiglie, specialmente le più fragili. FOCUS DI ATTENZIONE L’implementazione delle misure nazionali di contrasto alla povertà L’acuirsi della povertà e delle diseguaglianze: dimensioni e caratteristiche L’abitare: diritto delle persone e delle famiglie e fattore di inclusione sociale},
  langid = {italian},
  organization = {Welforum.it},
  file = {/Users/luisamimmi/Zotero/storage/WMRNTB5U/poverta-e-disuguaglianze.html}
}

